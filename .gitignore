# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Personal prep material - not part of the submission
DEMO_SCRIPT.md

run_website.bat

# Play Store signing - never commit private keys
android/key.properties
*.jks
*.keystore
android/build/

# --- Security hardening (added before the GitHub upload) ---

# Environment files and any other secrets
.env
.env.*
*.env
!.env.example
*.pem
*.p12

# Local tool state written by the Vercel CLI (`vercel link` et al.)
.vercel/

# Machine-specific paths should never leave the build machine.
# (The android/ copy is already excluded by android/.gitignore.)
/local.properties
.vercel
.env*
